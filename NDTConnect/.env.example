# NDT Connect — environment variables
# 2026-04-26 — Firebase removed. All persistence is MongoDB on the Hostinger VPS.
# Copy this file to .env.local for local dev, set the same keys in Vercel
# Project Settings → Environment Variables for production.

# ─────────── App ───────────
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# In production this is https://ndt-connect.com (the marketing/SEO domain).
# The Flutter app lives at https://app.ndt-connect.com and consumes the same /api/*.

# ─────────── MongoDB on Hostinger VPS ───────────
# Reach mongod externally on 443 with tlsAllowInvalidHostnames per the existing
# nginx stream SNI proxy. Prefer mongodb+srv on a private cluster if you migrate.
# Example with the VPS-direct connection:
#   mongodb://ndtconnect_app:STRONG_PASSWORD@148.230.122.172:443/ndtconnect?tls=true&tlsAllowInvalidHostnames=true&authSource=admin
MONGODB_URI=mongodb://USER:PASS@148.230.122.172:443/ndtconnect?tls=true&tlsAllowInvalidHostnames=true&authSource=admin

# ─────────── Auth ───────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Same secret must be deployed to BOTH the Vercel project AND any worker that
# verifies tokens. Rotate by deploying a NEW secret + a 24-hour overlap window.
JWT_SECRET=PASTE_64_CHAR_HEX_HERE

# ─────────── Email (Hostinger SMTP) ───────────
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@ndt-connect.com
SMTP_PASS=YOUR_SMTP_PASSWORD

# ─────────── AI (Google Gemini) ───────────
GEMINI_API_KEY=YOUR_GEMINI_KEY

# ─────────── Analytics ───────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ─────────── Mapbox (server-side token used by /api/providers/nearby tiles) ───────────
MAPBOX_PUBLIC_TOKEN=pk.eyJ.YOUR_TOKEN
# The Flutter app (mobile/) reads this same token via build-time --dart-define.
# Public tokens are scope-limited; never use a secret token here.

# ─────────── Stripe (kept for future paid tier; unused at v1 launch) ───────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─────────── Pusher (chat — v1.1) ───────────
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
