{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "flutter pub get && flutter build web --release -t lib/main_web.dart --dart-define=MAPBOX_PUBLIC_TOKEN=$MAPBOX_PUBLIC_TOKEN --dart-define=API_BASE_URL=$API_BASE_URL",
  "outputDirectory": "build/web",
  "framework": null,
  "installCommand": "git clone --depth 1 -b stable https://github.com/flutter/flutter.git $HOME/flutter && export PATH=\"$HOME/flutter/bin:$PATH\" && flutter --version",
  "devCommand": "flutter run -d web-server --web-port 3000 -t lib/main_web.dart",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options",        "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy",        "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy",     "value": "camera=(self), microphone=(), geolocation=(self)" }
      ]
    },
    {
      "source": "/(.*\\.(js|css|wasm|svg|png|jpg|woff2|ttf))",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(index\\.html|manifest\\.json|flutter_service_worker\\.js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
