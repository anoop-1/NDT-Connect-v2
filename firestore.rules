rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if request is from an authenticated user
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: check if user owns this document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper: check user role from their user document
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }

    // ==================== USERS ====================
    match /users/{userId} {
      // Anyone authenticated can read provider/inspector profiles (for marketplace)
      allow read: if isAuthenticated();
      // Users can create their own profile
      allow create: if isOwner(userId);
      // Users can update their own profile, admins can update any
      allow update: if isOwner(userId) || isAdmin();
      // Only admins can delete users
      allow delete: if isAdmin();
    }

    // ==================== SERVICE REQUESTS ====================
    match /serviceRequests/{requestId} {
      // Clients can read their own requests, providers can read requests assigned to them or unassigned
      allow read: if isAuthenticated() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.providerId == request.auth.uid ||
        resource.data.providerId == null ||
        isAdmin()
      );
      // Authenticated clients can create requests
      allow create: if isAuthenticated() && request.resource.data.clientId == request.auth.uid;
      // Client who owns it or assigned provider can update
      allow update: if isAuthenticated() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.providerId == request.auth.uid ||
        isAdmin()
      );
      // Only admins can delete requests
      allow delete: if isAdmin();
    }

    // ==================== CHATS ====================
    match /chats/{chatId} {
      // Only participants can read/write
      allow read, write: if isAuthenticated() && request.auth.uid in resource.data.participantIds;
      allow create: if isAuthenticated();

      match /messages/{messageId} {
        // Participants of parent chat can read/write messages
        allow read, write: if isAuthenticated() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
      }
    }

    // ==================== PREDEFINED LISTS ====================
    match /predefinedLists/{listId} {
      // Anyone can read (used for dropdowns)
      allow read: if true;
      // Only admins can write
      allow write: if isAdmin();
    }

    // ==================== REVIEWS ====================
    match /reviews/{reviewId} {
      // Anyone authenticated can read reviews
      allow read: if isAuthenticated();
      // Only clients can create reviews for completed requests
      allow create: if isAuthenticated();
      // Only the reviewer or admin can update/delete
      allow update, delete: if isAuthenticated() && (
        resource.data.reviewerId == request.auth.uid || isAdmin()
      );
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
