# NDTConnect Environment Variables
# Copy to .env.local for local development

# ===================
# Database
# ===================
MONGODB_URI=your_mongodb_connection_string

# ===================
# Firebase (existing)
# ===================
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id

# ===================
# Upstash Redis (Vercel-compatible)
# Get from: https://console.upstash.com
# ===================
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# ===================
# Pusher (Real-time events)
# Get from: https://dashboard.pusher.com
# ===================
PUSHER_APP_ID=your_app_id
PUSHER_SECRET=your_pusher_secret
NEXT_PUBLIC_PUSHER_KEY=your_pusher_key
NEXT_PUBLIC_PUSHER_CLUSTER=us2

# ===================
# Mapbox (Maps)
# Get from: https://account.mapbox.com
# ===================
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token

# ===================
# Stripe (Payments) - existing
# ===================
STRIPE_SECRET_KEY=your_stripe_secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable

# ===================
# App URLs
# ===================
NEXT_PUBLIC_APP_URL=https://ndtconnect.com
NEXT_PUBLIC_API_URL=https://ndtconnect.com/api
